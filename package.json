{
  "name": "cheque-key-marketplace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "set NEXT_DISABLE_SWC_NATIVE=1 && set APP_HOST=127.0.0.1 && set PORT=3000 && next dev -H 127.0.0.1 -p 3000",
    "dev:network": "set NEXT_DISABLE_SWC_NATIVE=1 && set APP_HOST=0.0.0.0 && set PORT=3000 && next dev -H 0.0.0.0 -p 3000",
    "build": "set NEXT_DISABLE_SWC_NATIVE=1 && next build",
    "prestart": "npm run build",
    "start": "set NEXT_DISABLE_SWC_NATIVE=1 && set APP_HOST=127.0.0.1 && set PORT=3001 && next start -H 127.0.0.1 -p 3001",
    "start:network": "set NEXT_DISABLE_SWC_NATIVE=1 && set APP_HOST=0.0.0.0 && set PORT=3000 && next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "network:info": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/network-info.ts",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:360": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" prisma/seed-360-samples.ts",
    "import:demo-db": "ts-node --transpile-only prisma/import-demo-db.ts",
    "test:ai-live": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/ai-live-smoke.ts",
    "test:ai-live:browser": "node scripts/ai-live-browser-smoke.js",
    "test:services": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" tests/services/run-phase2-checks.ts",
    "test:acceptance": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" tests/verification/run-phase14-acceptance.ts"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@prisma/client": "6.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "nodemailer": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.9.3",
    "three": "^0.184.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "6.0.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
