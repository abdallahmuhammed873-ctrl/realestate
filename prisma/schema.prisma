generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  BUY
  RENT
  VACATION
}

enum PropertyType {
  APARTMENT
  VILLA
  DUPLEX
  PENTHOUSE
  CHALET
  LAND
  COMMERCIAL
}

enum Furnishing {
  FULLY
  SEMI
  UNFURNISHED
}

enum PaymentType {
  CASH
  INSTALLMENTS
}

enum CompletionStatus {
  OFF_PLAN
  READY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  role         Role
  listings     Listing[]
  favorites    Favorite[]
  appointments Appointment[]
  savedSearches SavedSearch[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Listing {
  id         String        @id @default(cuid())
  userId     String
  status     ListingStatus @default(DRAFT)
  adminNotes String?
  reviewedBy String?
  reviewedAt DateTime?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Property {
  id                     String           @id @default(cuid())
  listingId              String           @unique
  listing                Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title                  String
  description            String
  transaction            TransactionType
  type                   PropertyType
  price                  Int?
  rentPrice              Int?
  currency               String           @default("EGP")
  bedrooms               Int
  bathrooms              Int
  areaSqm                Int
  lat                    Float
  lng                    Float
  address                String
  city                   String
  area                   String
  district               String
  furnishing             Furnishing
  paymentType            PaymentType
  completionStatus       CompletionStatus
  amenities              String[]
  images                 String[]
  installmentDownPayment Int?
  installmentYears       Int?
  installmentMonthly     Int?
  favorites              Favorite[]
  appointments           Appointment[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Appointment {
  id           String            @id @default(cuid())
  userId       String
  propertyId   String
  datetime     DateTime
  status       AppointmentStatus @default(PENDING)
  contactName  String
  contactPhone String
  notes        String?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  queryJson Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
